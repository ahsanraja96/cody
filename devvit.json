{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "psst-daily",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "index.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html"
      },
      "_gameplay": {
        "entry": "game.html"
      },
      "_direct_launch": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "journeys": true,
    "reddit": {
      "enable": true,
      "asUser": [
        "SUBMIT_COMMENT",
        "SUBSCRIBE_TO_SUBREDDIT"
      ]
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/install"
  },
  "scheduler": {
    "tasks": {
      "open-town": {
        "endpoint": "/internal/cron/open-town",
        "cron": "0 0 * * *"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Psst! Open today's town",
        "description": "Posts today's rumor if it is not up yet",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/menu/open-town"
      }
    ]
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "marketingAssets": {
    "icon": "assets/icon.png"
  }
}
